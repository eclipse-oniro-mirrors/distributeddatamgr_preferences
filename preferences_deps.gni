  if (defined(global_parts_info) &&
      defined(global_parts_info.security_access_token)) {
    preferences_access_token_enabled = true
  } else {
    preferences_access_token_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.bundlemanager_bundle_framework)) {
    preferences_bundle_framework_enabled = true
  } else {
    preferences_bundle_framework_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.arkcompiler_runtime_core)) {
    preferences_runtime_core_enabled = true
  } else {
    preferences_runtime_core_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.arkcompiler_ets_frontend)) {
    preferences_ets_frontend_enabled = true
  } else {
    preferences_ets_frontend_enabled = false
  }

  if (defined(global_parts_info) && defined(global_parts_info.ffrt)) {
    preferences_ffrt_enabled = true
  } else {
    preferences_ffrt_enabled = false
  }
}

