      defined(global_parts_info.hiviewdfx_hilog)) {
    preferences_hilog_enabled = true
  } else {
    preferences_hilog_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hitrace)) {
    preferences_hitrace_enabled = true
  } else {
    preferences_hitrace_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.hiviewdfx_hisysevent)) {
    preferences_hisysevent_enabled = true
  } else {
    preferences_hisysevent_enabled = false
  }

  if (defined(global_parts_info) && defined(global_parts_info.arkui_napi)) {
    preferences_napi_enabled = true
  } else {
    preferences_napi_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.communication_ipc)) {
    preferences_ipc_enabled = true
  } else {
    preferences_ipc_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.notification_common_event_service)) {
    preferences_common_event_service_enabled = true
  } else {
    preferences_common_event_service_enabled = false
