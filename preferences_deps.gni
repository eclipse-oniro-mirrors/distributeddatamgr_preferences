import("//foundation/distributeddatamgr/preferences/preferences.gni")

preferences_mock_external_kit_path = "${preferences_base_path}/preferencesmock/external_inner_kit"

declare_args() {
  if (defined(global_parts_info) &&
      defined(global_parts_info.ability_ability_base)) {
    preferences_ability_base_enabled = true
  } else {
    preferences_ability_base_enabled = false
  }

  if (defined(global_parts_info) &&
      defined(global_parts_info.ability_ability_runtime)) {
    preferences_ability_runtime_enabled = true
