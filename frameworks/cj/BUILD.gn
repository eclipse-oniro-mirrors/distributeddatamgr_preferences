import("//build/ohos.gni")
import("//build/ohos/ace/ace.gni")
import("//foundation/distributeddatamgr/preferences/preferences.gni")
import("//foundation/distributeddatamgr/preferences/preferences_deps.gni")

base_include = [ "${preferences_base_path}/frameworks/common/include" ]

base_sources = [
  "${preferences_cj_path}/preferences_ffi.cpp",
  "${preferences_cj_path}/preferences_impl.cpp",
  "${preferences_cj_path}/preferences_utils.cpp",
]

if (is_ohos) {
  ohos_shared_library("cj_preferences_ffi") {
    include_dirs = base_include
    sources = base_sources

    branch_protector_ret = "pac_ret"
    sanitize = {
      boundary_sanitize = true
      ubsan = true
      cfi = true
      cfi_cross_dso = true
      debug = false
    }
    cflags_cc = [
      "-std=c++17",
      "-stdlib=libc++",
      "-fvisibility=hidden",
      "-Werror=vla",
    ]

    deps = [ "${preferences_base_path}/interfaces/inner_api:native_preferences" ]

    deps += deps_ability_runtime
    deps += deps_hilog
    deps += deps_ipc_single
    deps += deps_napi
    deps += deps_cj_bind_ffi
    deps += deps_cj_bind_native

    external_deps = [
      "c_utils:utils",
    ]
    external_deps += external_deps_ability_runtime
    external_deps += external_deps_hilog
    external_deps += external_deps_ipc_single
    external_deps += external_deps_napi
    external_deps += external_deps_cj_bind_ffi
    external_deps += external_deps_cj_bind_native

    subsystem_name = "distributeddatamgr"
    part_name = "preferences"
    innerapi_tags = [ "platformsdk" ]
  }
} else if (is_mingw || is_mac) {
  ohos_shared_library("cj_preferences_ffi") {
    include_dirs = base_include
    sources = base_sources

    cflags_cc = [
      "-std=c++17",
      "-stdlib=libc++",
      "-Werror=vla",
    ]
    if (is_mac) {
      defines = [ "MAC_PLATFORM" ]
    } else {
      defines = [ "WINDOWS_PLATFORM" ]
    }

    deps = [ "${preferences_base_path}/interfaces/inner_api:native_preferences" ]

    deps += deps_hilog
    deps += deps_napi
    deps += deps_cj_bind_ffi
    deps += deps_cj_bind_native

    external_deps = []
    external_deps += external_deps_hilog
    external_deps += external_deps_napi
    external_deps += external_deps_cj_bind_ffi
    external_deps += external_deps_cj_bind_native

    subsystem_name = "distributeddatamgr"
    part_name = "preferences"
    innerapi_tags = [ "platformsdk" ]
  }
} else {
  ohos_shared_library("cj_preferences_ffi") {
    include_dirs = base_include
    include_dirs += [
      "//foundation/arkui/napi/interfaces/inner_api/cjffi/cj_ffi",
      "//foundation/arkui/napi/interfaces/inner_api/cjffi/native",
      "//foundation/arkui/napi/interfaces/inner_api/cjffi",
    ]
    sources = base_sources

    cflags_cc = [
      "-std=c++17",
      "-include",
      "algorithm",
      "-Werror=vla",
    ]

    deps = [ "${preferences_base_path}/interfaces/inner_api:native_preferences" ]

    deps += deps_ability_runtime
    deps += deps_hilog
    deps += deps_ipc_single
    deps += deps_napi
    deps += [ "${preferences_mock_external_kit_path}/napi:cj_bind_ffi" ]
    deps += [ "${preferences_mock_external_kit_path}/napi:cj_bind_native" ]

    external_deps = [
      "c_utils:utils",
    ]
    external_deps += external_deps_ability_runtime
    external_deps += external_deps_hilog
    external_deps += external_deps_ipc_single
    external_deps += external_deps_napi

    subsystem_name = "distributeddatamgr"
    part_name = "preferences"
    innerapi_tags = [ "platformsdk" ]
  }
}
