+        Object::DecStrongRef(id);                                       \
+    }                                                                   \
+                                                                        \
+    IInterface *(ClassName)::Query(const InterfaceID & iid)             \
+    {                                                                   \
+        if (iid == g_IID_##InterfaceName) {                             \
+            return static_cast<InterfaceName *>(this);                  \
+        }                                                               \
+        if (iid == g_IID_IInterface) {                                  \
