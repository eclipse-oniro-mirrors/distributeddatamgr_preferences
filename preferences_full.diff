+ * @param object The object to set the property on.
+ * @param key The key name of the property to set.
+ * @param value The property value to set.
+ * @param info Callsite info handle for IC caching. Can be NULL.
+ * @param hit Receives whether the IC cache was hit (true) or missed (false).
+ *
+ * @return Returns the function execution status.
+ *         {@link napi_ok } If the function executed successfully.\n
+ *         {@link napi_invalid_arg } If env, object, key or value is nullptr.\n
+ *         {@link napi_object_expected } If the param object is not an ArkTS Object.\n
+ *         {@link napi_pending_exception } If have uncaught exception, or exception occurred in execution.\n
+ * @since 24
+ */
+NAPI_EXTERN napi_status napi_set_property_with_callsite_info(napi_env env,
+    napi_value object,
+    napi_value key,
+    napi_value value,
+    napi_callsite_info info,
+    bool* hit);
+
+/**
+ * @brief Creates an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param result The ArkTS Map object created.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_create_map(napi_env env, napi_value* result);
+
+/**
+ * @brief Gets the size of an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param result The size of the Map.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_size(napi_env env, napi_value map, uint32_t* result);
+
+/**
+ * @brief Sets a property in an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param key The key of the property.
+ * @param value The value of the property.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_set_property(napi_env env, napi_value map, napi_value key, napi_value value);
+
+/**
+ * @brief Sets a named property in an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param utf8name The name of the property.
+ * @param value The value of the property.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_set_named_property(napi_env env, napi_value map, const char* utf8name, napi_value value);
+
+/**
+ * @brief Gets a property from an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param key The key of the property.
+ * @param result The value of the property.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_property(napi_env env, napi_value map, napi_value key, napi_value* result);
+
+/**
+ * @brief Gets a named property from an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param utf8name The name of the property.
+ * @param result The value of the property.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_named_property(napi_env env, napi_value map,
+    const char* utf8name, napi_value* result);
+
+/**
+ * @brief Checks if a property exists in an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param key The key of the property.
+ * @param result True if the property exists, false otherwise.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_has_property(napi_env env, napi_value map, napi_value key, bool* result);
+
+/**
+ * @brief Checks if a named property exists in an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param utf8name The name of the property.
+ * @param result True if the property exists, false otherwise.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_has_named_property(napi_env env, napi_value map, const char* utf8name, bool* result);
+
+/**
+ * @brief Deletes a property from an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param key The key of the property to delete.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_delete_property(napi_env env, napi_value map, napi_value key);
+
+/**
+ * @brief Clears all properties from an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_clear(napi_env env, napi_value map);
+
+/**
+ * @brief Gets all entries of an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param result An iterator for the Map entries.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_entries(napi_env env, napi_value map, napi_value* result);
+
+/**
+ * @brief Gets all keys of an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param result An iterator for the Map keys.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_keys(napi_env env, napi_value map, napi_value* result);
+
+/**
+ * @brief Gets all values of an ArkTS Map object.
+ * @param env Current running virtual machine context.
+ * @param map The ArkTS Map object.
+ * @param result An iterator for the Map values.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_get_values(napi_env env, napi_value map, napi_value* result);
+
+/**
+ * @brief Gets the next entry from a Map iterator.
+ * @param env Current running virtual machine context.
+ * @param iterator The Map iterator.
+ * @param result The next entry from the iterator.
+ * @return Returns the function execution status.
+ * @since 12
+ */
+NAPI_EXTERN napi_status napi_map_iterator_get_next(napi_env env, napi_value iterator, napi_value* result);
+
+#ifdef __cplusplus
+}
