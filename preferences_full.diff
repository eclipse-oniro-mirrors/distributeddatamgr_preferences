+    ERR_APPEXECFWK_INSTALLD_COPY_FILE_FAILED            = APPEXECFWK_INSTALLD_ERR_OFFSET + 9  * ERRNO_MAX_SIZE,
+    // = 10028808
+    ERR_APPEXECFWK_INSTALLD_MKDIR_FAILED                = APPEXECFWK_INSTALLD_ERR_OFFSET + 10 * ERRNO_MAX_SIZE,
+    // = 10029008
+    ERR_APPEXECFWK_INSTALLD_PERMISSION_DENIED           = APPEXECFWK_INSTALLD_ERR_OFFSET + 11 * ERRNO_MAX_SIZE,
+    // = 10029208
+    ERR_APPEXECFWK_INSTALLD_SET_SELINUX_LABEL_FAILED    = APPEXECFWK_INSTALLD_ERR_OFFSET + 12 * ERRNO_MAX_SIZE,
+    // = 10029408
+    ERR_APPEXECFWK_INSTALLD_AOT_EXECUTE_FAILED          = APPEXECFWK_INSTALLD_ERR_OFFSET + 13 * ERRNO_MAX_SIZE,
