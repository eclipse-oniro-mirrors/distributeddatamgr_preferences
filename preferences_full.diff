+    ERR_APPEXECFWK_INSTALLD_EXTRACT_FAILED              = APPEXECFWK_INSTALLD_ERR_OFFSET + 22 * ERRNO_MAX_SIZE,
+    // = 10031408
+    ERR_APPEXECFWK_INSTALLD_RESTORECON_PATH_FAILED      = APPEXECFWK_INSTALLD_ERR_OFFSET + 23 * ERRNO_MAX_SIZE,
+    // = 10031608
+    ERR_APPEXECFWK_INSTALLD_CHANGE_FILE_STAT_FAILED     = APPEXECFWK_INSTALLD_ERR_OFFSET + 24 * ERRNO_MAX_SIZE,
+    // = 10031808
+    ERR_APPEXECFWK_INSTALLD_COPY_DIR_FAILED             = APPEXECFWK_INSTALLD_ERR_OFFSET + 25 * ERRNO_MAX_SIZE,
