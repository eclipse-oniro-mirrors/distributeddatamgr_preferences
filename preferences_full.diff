+bool MessageParcel::WriteRawData(const void *data, size_t size)
+{
+    auto rawDataBuf = std::make_shared<std::vector<char>>(rawDataSize_ + size, '\0');
+    if (memcpy_s(rawDataBuf->data() + rawDataSize_, size, data, size) != EOK) {
+        return false;
+    }
+    if (rawData_ != nullptr) {
+        if (memcpy_s(rawDataBuf->data(), rawDataSize_, rawData_.get(), rawDataSize_) != EOK) {
+            return false;
+        }
+    }
+    rawData_ = std::shared_ptr<char>(rawDataBuf->data(), [rawDataBuf](char *) {});
+    rawDataSize_ += size;
+    return true;
+}
+const void *MessageParcel::ReadRawData(size_t size)
+{
+    if (rawDataSize_ < size) {
+        return nullptr;
+    }
+    rawDataSize_ -= size;
+    void *ptr = &(rawData_.get())[g_cursor];
+    g_cursor += size;
+    return ptr;
+}
