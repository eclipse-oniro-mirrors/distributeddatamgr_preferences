+        return windowHeight_;
+    }
+
+    virtual bool Marshalling(Parcel &parcel) const override
+    {
+        return true;
+    }
+    static StartOptions *Unmarshalling(Parcel &parcel)
+    {
+        return new StartOptions();
+    }
