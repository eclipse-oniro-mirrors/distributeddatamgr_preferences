+    GET_GRANTED_SESSION_NAME = ZIPC_PACK_CHARS('_', 'G', 'G', 'S'),
+    REMOVE_SESSION_NAME = ZIPC_PACK_CHARS('_', 'R', 'S', 'N'),
+    CLEAR_DBINDER_SERVICE_STATE = ZIPC_PACK_CHARS('_', 'D', 'C', 'S'),
