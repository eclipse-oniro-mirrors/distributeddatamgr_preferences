+namespace OHOS {
+class IPCSkeleton {
+public:
+    IPCSkeleton() = default;
+    ~IPCSkeleton() = default;
+
+    /**
+     * @brief Set the maximum number of threads.
+     * @param maxThreadNum default max is 16, only if you need a customize value.
+     * @return Returns <b>true</b> if the operation succeeds; return <b>false</b> Otherwise.
+     * @since 9
+     */
