+    PERMISSION_ENTERPRISE_NORMAL_RULE
+} PermissionRulesEnum;
+
+typedef enum RegisterPermissionChangeType {
+    SYSTEM_REGISTER_TYPE = 0,
+    SELF_REGISTER_TYPE = 1,
+} RegisterPermChangeType;
+
+typedef enum HapPolicyCheckIgnoreType {
