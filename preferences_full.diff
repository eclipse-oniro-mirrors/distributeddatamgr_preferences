+    LAST_CALL_TRANSACTION = 0x00ffffff,
+    PING_TRANSACTION = ZIPC_PACK_CHARS('_', 'P', 'N', 'G'),
+    DUMP_TRANSACTION = ZIPC_PACK_CHARS('_', 'D', 'M', 'P'),
