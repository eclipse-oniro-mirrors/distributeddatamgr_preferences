+} UserPermissionPolicy;
+
+typedef enum UpdateWhiteListType {
+    ADD = 0,
+    DELETE,
+} UpdateWhiteListType;
+
+typedef enum TypePermissionRulesEnum {
+    PERMISSION_EDM_RULE = 0,
