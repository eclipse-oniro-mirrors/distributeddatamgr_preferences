+extern "C" void* FFIGetContext(int64_t id);
+
+class CJLambda {
+public:
+    template<class... I>
+    static std::function<void(I...)> Create(void (*callback)(I...))
+    {
+        return [callback](I... args) -> void {
+            callback(args...);
+        };
+    }
+
+    template<class... I, class R>
+    static std::function<R(I...)> Create(R (*callback)(I...))
+    {
+        return [callback](I... args) -> R {
+            return callback(args...);
+        };
+    }
+};
+
+#endif
