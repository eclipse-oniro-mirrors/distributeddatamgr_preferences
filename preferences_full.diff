+        if (rawData_ == nullptr) {
+            return false;
+        }
+        bool ret = RawDataEncoder::UnsignedVarintEncoded(*rawData_, EncodeType::LENGTH_DELIMITED, vals_.size());
+        for (auto item : vals_) {
+            ret = ret && RawDataEncoder::SignedVarintEncoded(*rawData_, EncodeType::VARINT, item);
+        }
+        return ret;
+    }
+
+private:
+    std::vector<T> vals_;
+};
