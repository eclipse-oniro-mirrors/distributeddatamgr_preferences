import("//build/ohos.gni")

config("napi_config") {
  include_dirs = [
    "include",
    "//foundation/arkui/napi/interfaces/inner_api/cjffi/cj_ffi",
    "//foundation/arkui/napi/interfaces/inner_api/cjffi/native",
    "//foundation/arkui/napi/interfaces/inner_api/cjffi",
  ]
  cflags_cc = [
    "-Wno-unused-private-field",
  ]
}

ohos_source_set("ace_napi") {
  configs = [ ":napi_config" ]
  sources = [ "mock_napi.cpp" ]
  all_dependent_configs = [ ":napi_config" ]
  public_configs = [ ":napi_config" ]
  external_deps = [ "c_utils:utils" ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  part_name = "preferences"
  subsystem_name = "distributeddatamgr"
}

ohos_source_set("cj_bind_ffi") {
  configs = [ ":napi_config" ]
  sources = [
    "mock_cj_bind_ffi.cpp",
    "mock_ffi_remote_data.cpp",
  ]
  all_dependent_configs = [ ":napi_config" ]
  public_configs = [ ":napi_config" ]
  external_deps = [ "c_utils:utils" ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  part_name = "preferences"
  subsystem_name = "distributeddatamgr"
}

ohos_source_set("cj_bind_native") {
  configs = [ ":napi_config" ]
  sources = [ "mock_cj_bind_native.cpp" ]
  all_dependent_configs = [ ":napi_config" ]
  public_configs = [ ":napi_config" ]
  external_deps = [ "c_utils:utils" ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  part_name = "preferences"
  subsystem_name = "distributeddatamgr"
}