import("//build/ohos.gni")
import("//foundation/distributeddatamgr/preferences/preferences.gni")
import("//foundation/distributeddatamgr/preferences/preferences_deps.gni")

config("samgr_all_deps_config") {
  include_dirs = [ "${preferences_mock_external_kit_path}/samgr/include" ]
}

ohos_source_set("samgr_proxy") {
  sources = []
  all_dependent_configs = [ ":samgr_all_deps_config" ]
  public_configs = [ ":samgr_all_deps_config" ]
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  part_name = "preferences"
  subsystem_name = "distributeddatamgr"
}
